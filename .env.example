# 环境变量配置示例
# 复制此文件为 .env 并填入真实配置（.env 已被 .gitignore 忽略，切勿提交真实密钥）

# 数据库配置
DB_ROOT_PASSWORD=__CHANGE_ME__
DB_USER=community
DB_PASS=__CHANGE_ME__

# Redis 配置
REDIS_PASS=__CHANGE_ME__

# JWT 密钥（必填，长度至少 32 字节 / 256 位）
# 生成示例：openssl rand -base64 48
JWT_SECRET=__CHANGE_ME_AT_LEAST_32_BYTES__
# 可选：token 有效期（毫秒），默认 1 天
# JWT_EXPIRATION=86400000

# CORS 允许的来源（逗号分隔），生产环境填写真实前端域名
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# 前端 API 基址
# 通过 Nginx 反代访问时可以留空；如果单独跑前端开发服务器，可设置为 http://localhost:8080
# NUXT_PUBLIC_API_BASE=

# 阿里云 OSS 配置
OSS_ACCESS_KEY_ID=__CHANGE_ME__
OSS_ACCESS_KEY_SECRET=__CHANGE_ME__
OSS_BUCKET_NAME=your_bucket_name
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
